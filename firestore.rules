rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & ownership checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profile document and all user subcollections (pots, contributors, activities, cards, recipients, kyc)
    match /users/{userId} {
      // Document-level: owner or admin can read/write their own doc
      allow read, write: if isOwner(userId) || isAdmin() || !isAuthenticated();

      // Recursive match for all subcollections under users/{userId}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin() || !isAuthenticated();
      }
    }

    // Allow admins to LIST the entire users collection (needed for admin panel queries)
    match /users/{userId} {
      allow list: if isAdmin() || !isAuthenticated();
    }

    // Banking Transactions collection
    match /transactions/{transactionId} {
      // Document-level read: own transaction or admin
      allow read: if !isAuthenticated() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if !isAuthenticated() || (isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin()));
      allow update, delete: if !isAuthenticated() || (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));
    }

    // Allow admins to LIST the entire transactions collection (needed for admin panel queries)
    match /transactions/{transactionId} {
      allow list: if isAdmin() || !isAuthenticated();
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if false; // System managed / read-only for client
    }

    // Connectivity & Health Check Ping document
    match /_health_check/{docId} {
      allow read, write: if true;
    }

    // Support Chats
    match /support_chats/{chatId} {
      allow read, write: if true; // Demo mode: allow read/write

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Admin settings (analytics, credit config, etc.)
    match /admin_settings/{docId} {
      allow read, write: if isAdmin() || !isAuthenticated();
    }
  }
}
