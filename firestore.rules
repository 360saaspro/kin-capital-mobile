rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth & ownership checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document and all user subcollections (pots, contributors, activities, cards, recipients, kyc)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || !isAuthenticated();

      // Recursive match for all subcollections under users/{userId}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || !isAuthenticated();
      }
    }

    // Banking Transactions collection
    match /transactions/{transactionId} {
      allow read: if !isAuthenticated() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if !isAuthenticated() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if !isAuthenticated() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if false; // System managed / read-only for client
    }

    // Connectivity & Health Check Ping document
    match /_health_check/{docId} {
      allow read, write: if true;
    }

    // Support Chats
    match /support_chats/{chatId} {
      allow read, write: if true; // Demo mode: allow read/write

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}

